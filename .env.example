# Optional. Default local state directory is .runtime/ (ignored by Git).
# Keep private state inside ignored .runtime/ or .data/, or outside the repo.
# WARDROBE_DATA_DIR=.runtime

# Optional local Photos inventory JSON; see docs/photos.md.
# WARDROBE_PHOTOS_INVENTORY=/absolute/path/to/inventory.json
# WARDROBE_PHOTOS_LIBRARY=/absolute/path/to/Photos Library.photoslibrary
# WARDROBE_ENABLE_PHOTOS=1

# Optional paid text-to-image generation, explicitly triggered in an item page.
# OPENAI_API_KEY=
